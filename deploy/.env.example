# Copy to deploy/.env; supply secrets only in that ignored file.
ADMIN_TOKEN=
ZHIHU_ACCESS_SECRET=
SCHEDULER_ENABLED=true
# Optional finite trial: ISO timestamp with timezone, e.g. 2026-10-10T08:00:00+08:00.
# SCHEDULER_UNTIL=
SAMPLING_INTERVAL_MINUTES=180
JOB_TIMEOUT_SECONDS=1800
MATCHING_PROFILE=hybrid_rerank
SEMANTIC_CPU_THREADS=4
OFFICIAL_SEARCH_ENABLED=true
WEIBO_CLI_ENABLED=false
WEIBO_CLI_TOKEN=
WEIBO_CLI_REFRESH_TOKEN=
BRIEFING_TIMEZONE=Asia/Shanghai
RUNTIME_LOG_RETENTION_DAYS=14
# Enables fresh daily collection + quality-gated automatic approval.
DAILY_BRIEFING_ENABLED=true
EMAIL_SCHEDULE_ENABLED=true
EMAIL_SEND_TIME=08:00
EMAIL_RECIPIENTS='[]'
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20
EMAIL_MAX_ATTEMPTS=3
# SSH tunnel uses HTTP only on loopback. Set true if later serving over HTTPS.
ADMIN_COOKIE_SECURE=false
