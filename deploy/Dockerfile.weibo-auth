# Uses the same CLI version and user ID as the backend, without loading models.
FROM m.daocloud.io/docker.io/library/node@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
RUN npm install --prefix /opt/weibo @weibo-ai/weibo-cli@0.9.1 \
    && ln -s /opt/weibo/node_modules/.bin/weibo-cli /usr/local/bin/weibo-cli \
    && useradd --uid 10001 --create-home app \
    && mkdir -p /home/app/.weibo-cli \
    && chown -R app:app /home/app/.weibo-cli
ENV HOME=/home/app
USER app
ENTRYPOINT ["weibo-cli"]
