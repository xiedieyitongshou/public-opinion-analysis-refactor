APP_NAME="Public Opinion Analysis Backend"
APP_ENV="local"
DEBUG=true
DATABASE_URL="sqlite:///./data/app.db"
ZHIHU_ACCESS_SECRET=""
ZHIHU_API_BASE_URL="https://developer.zhihu.com"
ZHIHU_HOT_LIST_PATH="/api/v1/content/hot_list"
ZHIHU_SEARCH_PATH="/api/v1/content/zhihu_search"
ZHIHU_QUOTA_PATH="/api/v1/quota"
ZHIHU_FETCH_LIMIT=30
ZHIHU_TIMEOUT_SECONDS=20
WEIBO_RSSHUB_BASE_URL="http://localhost:1200"
WEIBO_RSSHUB_ROUTE="/weibo/search/hot"
WEIBO_RSSHUB_FULLTEXT_ROUTE="/weibo/search/hot/fulltext"
WEIBO_RSSHUB_FETCH_LIMIT=20
WEIBO_RSSHUB_TIMEOUT_SECONDS=20
WEIBO_RSSHUB_MAX_RETRIES=2
WEIBO_RSSHUB_FAILURE_THRESHOLD=3
WEIBO_RSSHUB_SKIP_TOP=1
WEIBO_CLI_ENABLED=false
WEIBO_CLI_COMMAND="weibo-cli"
WEIBO_CLI_TOPIC_LIMIT=3
WEIBO_CLI_SEARCH_COUNT=5
WEIBO_CLI_TIMEOUT_SECONDS=30
# Optional for Docker/CI. Do not commit real tokens.
WEIBO_CLI_TOKEN=""
WEIBO_CLI_REFRESH_TOKEN=""
