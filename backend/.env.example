APP_NAME="Public Opinion Analysis Backend"
APP_ENV="local"
DEBUG=true
DATABASE_URL="sqlite:///./data/app.db"
ZHIHU_ACCESS_SECRET=""
ZHIHU_API_BASE_URL="https://developer.zhihu.com"
ZHIHU_HOT_LIST_PATH="/api/v1/content/hot_list"
ZHIHU_SEARCH_PATH="/api/v1/content/zhihu_search"
ZHIHU_QUOTA_PATH="/api/v1/quota"
ZHIHU_FETCH_LIMIT=30
ZHIHU_TIMEOUT_SECONDS=20
WEIBO_RSSHUB_BASE_URL="http://localhost:1200"
WEIBO_RSSHUB_ROUTE="/weibo/search/hot"
WEIBO_RSSHUB_FULLTEXT_ROUTE="/weibo/search/hot/fulltext"
WEIBO_RSSHUB_FETCH_LIMIT=20
WEIBO_RSSHUB_TIMEOUT_SECONDS=20
WEIBO_RSSHUB_MAX_RETRIES=2
WEIBO_RSSHUB_FAILURE_THRESHOLD=3
WEIBO_RSSHUB_SKIP_TOP=1
WEIBO_CLI_ENABLED=false
WEIBO_CLI_COMMAND="weibo-cli"
WEIBO_CLI_TOPIC_LIMIT=3
WEIBO_CLI_SEARCH_COUNT=5
WEIBO_CLI_TIMEOUT_SECONDS=30
# Optional for Docker/CI. Do not commit real tokens.
WEIBO_CLI_TOKEN=""
WEIBO_CLI_REFRESH_TOKEN=""

# LLM event extraction. Do not commit real API keys.
LLM_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
EVENT_EXTRACTION_USE_LLM=false
EVENT_EXTRACTION_LLM_CONFIDENCE_THRESHOLD=0.65

# Week 8 MVP. Run `python -m app.briefing_cli init` from backend to create a local admin token.
ADMIN_TOKEN=""
ADMIN_COOKIE_SECURE=false
SCHEDULER_ENABLED=false
SAMPLING_INTERVAL_MINUTES=180
JOB_TIMEOUT_SECONDS=900
QUOTA_PROBE_ENABLED=false
# JSON; each HTTP request/redirect/retry consumes a slot. CLI is a separate invocation count.
REQUEST_LIMITS='{"zhihu_hot_list":2,"zhihu_search":5,"zhihu_quota":1,"weibo_rsshub_hot_search":4,"weibo_cli":3,"chinanews_scroll_rss":3,"people_politics_rss":3,"xinhua_politics_rss":3,"official_search_people":3,"official_search_chinanews":3}'
BRIEFING_TIMEZONE="Asia/Shanghai"
EMAIL_SCHEDULE_ENABLED=false
EMAIL_SEND_TIME="08:00"
EMAIL_RECIPIENTS='[]'
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_SECURITY="starttls"
SMTP_TIMEOUT_SECONDS=20
EMAIL_MAX_ATTEMPTS=3
